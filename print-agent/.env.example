# Backend URL (same origin as the web app)
SERVER_URL=http://localhost:4000
# Token from Admin → Printers → Print agents → New agent
AGENT_TOKEN=
# Where downloaded fonts are cached
CACHE_DIR=./.cache
# Optional: comma-separated subnets to scan for :9100 printers (default: local interfaces)
SCAN_SUBNETS=

# ---- Gate / locker edge controller (gate or locker driver EDGE_AGENT) ----
# Device token from Admin → Park → Devices (type EDGE). Leave empty to disable.
DEVICE_TOKEN=
# Relay backend: simulate | gpio (libgpiod gpioset) | http (network relay board)
EDGE_RELAY=simulate
EDGE_GPIO_CHIP=gpiochip0
# For http: placeholders {pin} / {channel} / {state}
EDGE_RELAY_URL=
EDGE_RELAY_METHOD=GET
# auto = report PASSAGE after EDGE_PASSAGE_MS (no sensor); none = the gate reports passage itself
EDGE_PASSAGE=auto
EDGE_PASSAGE_MS=2500
EDGE_CLOSE_MS=800
EDGE_LOCKER_PULSE_MS=500
