{
  "name": "@kiosk/print-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local print agent: drives LAN / USB / serial / Bluetooth-SPP ESC/POS printers for the kiosk platform",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kiosk/shared": "1.0.0",
    "@napi-rs/canvas": "^1.0.10",
    "dotenv": "^17.2.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
