{
  "name": "kiosk-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Self-Ordering Kiosk + POS Cashier + Admin + KDS + Queue Display platform",
  "workspaces": [
    "packages/shared",
    "server",
    "web",
    "print-agent"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:agent": "npm run dev --workspace print-agent",
    "build": "npm run build --workspace server && npm run build --workspace web && npm run build --workspace print-agent",
    "start": "npm run start --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "node scripts/e2e-flow.mjs e2e-shots",
    "fake-printer": "node scripts/fake-printer.mjs fake-printer-out 9101"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
