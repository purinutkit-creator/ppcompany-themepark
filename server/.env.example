# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kiosk
# HTTP
PORT=4000
HOST=0.0.0.0
# Public URL of this server (used for receipt QR lookups and uploaded file URLs)
PUBLIC_URL=http://localhost:4000
# CORS origins for the web app (comma separated); empty = same-origin only
CORS_ORIGINS=http://localhost:5173
# Secrets — CHANGE IN PRODUCTION (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-value-1234567890
# HMAC secrets used to verify payment provider callbacks (per provider)
PAYMENT_WEBHOOK_SECRET_SANDBOX=sandbox-webhook-secret-change-me
# Tolerance window for webhook timestamps (seconds) — replay protection
WEBHOOK_TOLERANCE_SEC=300
UPLOAD_DIR=./uploads
# Serve the built web app from this directory (production single-container deploy)
WEB_DIST=../web/dist
LOG_LEVEL=info
